{
  "name": "neatpeek",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev:local:db": "dotenv -e .env.local -- prisma migrate dev",
    "dev:local": "dotenv -e .env.local -- prisma migrate dev && dotenv -e .env.local -- next dev -p 4455",
    "db:local:reset": "dotenv -e .env.local -- prisma migrate reset --force",
    "db:local:seed": "dotenv -e .env.local -- prisma db seed",
    "seed:local": "dotenv -e .env.local -- prisma migrate reset --force && dotenv -e .env.local -- prisma db seed",
    
    "dev:db": "dotenv -e .env.development -- prisma migrate deploy",
    "dev": "dotenv -e .env.development -- prisma migrate deploy && dotenv -e .env.development -- next dev",
    "dev:build": "dotenv -e .env.development -- prisma migrate deploy && dotenv -e .env.development -- next build",
    "dev:start": "dotenv -e .env.development -- next start",
    "seed:dev": "dotenv -e .env.development -- prisma migrate reset --force && dotenv -e .env.development -- prisma db seed",
    
    "prod:db": "dotenv -e .env.production -- prisma migrate deploy",
    "prod": "dotenv -e .env.production -- prisma migrate deploy && dotenv -e .env.production -- next dev",
    "prod:build": "dotenv -e .env.production -- prisma migrate deploy && dotenv -e .env.production -- next build",
    "prod:start": "dotenv -e .env.production -- next start",
    "seed:prod": "dotenv -e .env.production -- prisma migrate reset --force && dotenv -e .env.production -- prisma db seed",
    
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    
    "build": "next build",
    "build:scripts": "tsc --project tsconfig.scripts.json",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "format": "prettier --write .",
    "clean": "rm -rf .next dist-scripts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
